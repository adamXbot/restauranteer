# REQUIRED: where your Obsidian vault lives on the host.
VAULT_HOST_PATH=/Users/you/Documents/Obsidian/MyVault

# Optional external API keys
GOOGLE_PLACES_API_KEY=
MAPBOX_PUBLIC_TOKEN=

# Google Maps JS map provider (Settings → Map provider → Google).
# This key is exposed to the browser, so restrict it by HTTP referrer in
# Google Cloud Console. Can be the same key as GOOGLE_PLACES_API_KEY only
# if you've set referrer restrictions; otherwise use a separate key.
GOOGLE_MAPS_PUBLIC_KEY=

# Apple MapKit JS — two paths, pick ONE:
#
#  (a) Long-term (Apple Developer Program required) — set all three. The
#      private key is the contents of your .p8 file; \n escape sequences are
#      accepted for single-line env values. Server signs short-lived JWTs.
APPLE_MAPKIT_TEAM_ID=
APPLE_MAPKIT_KEY_ID=
APPLE_MAPKIT_PRIVATE_KEY=
#      If your MapKit key is restricted to a domain, set this to your site's
#      exact origin (scheme + host, no trailing slash) — it becomes the token's
#      `origin` claim. Must match the browser's location.origin exactly, e.g.
#      https://restauranteer.mydomain.com (https, apex vs www, and port all matter).
APPLE_MAPKIT_ORIGIN=
#
#  (b) Quick start — paste a pre-signed JWT from
#      https://maps.developer.apple.com/token-maker. No private-key signing
#      happens server-side; you must rotate this manually before it expires
#      (Apple defaults to 7 days for browser tokens). Takes precedence over
#      the three vars above when set.
APPLE_MAPKIT_TOKEN=

# Vault location inside the container. Usually leave these as-is.
VAULT_PATH=/data
VAULT_SUBDIR=Restaurants

# Where the SQLite index lives. Default: {vault}/.restauranteer/index.db —
# fine for a local vault, WRONG for a synced one (iCloud Drive, Dropbox):
# WAL churn becomes endless sync traffic. Point it somewhere local then.
# See docs/mac-shared-vault.md.
#RESTAURANTEER_INDEX_PATH=/home/you/.restauranteer/index.db

# Obsidian deep links (optional)
# Set to your vault's display name so "Open in Obsidian" buttons can resolve.
OBSIDIAN_VAULT_NAME=

# Sync API (for the iOS companion app) — see docs/sync-api.md
#
# Leave unset and /api/sync/* stays disabled (503). Set it and those routes
# require `Authorization: Bearer <token>`. Comma-separate for one token per
# device so you can revoke a lost phone on its own.
#   RESTAURANTEER_SYNC_TOKEN=$(openssl rand -hex 32)
# HTTPS is required — the token is sent on every request, and iOS App Transport
# Security blocks cleartext. Traefik + Let's Encrypt, or `tailscale cert`.
RESTAURANTEER_SYNC_TOKEN=

# Optional: extend the same bearer requirement to ALL of /api/* (not just
# /api/sync/*). This locks out the browser UI, whose own fetches carry no
# token — it's for headless deployments where only the iOS app talks to the
# server. Requires RESTAURANTEER_SYNC_TOKEN to be set as well.
# RESTAURANTEER_REQUIRE_AUTH=1

# App
PORT=3000
LOG_LEVEL=info

# Optional Docker image override for docker-compose.yml
# Default is adamxbot/restauranteer:latest from Docker Hub.
# RESTAURANTEER_IMAGE=adamxbot/restauranteer:latest
